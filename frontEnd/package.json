{
  "name": "frontend",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "tester": "node acceptance/record.js",
    "record": "node acceptance/record.js --recorder",
    "save": "node acceptance/record.js --save",
    "report": "node acceptance/record.js --report"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/test-utils/setup.ts"
    ],
    "clearMocks": true,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/acceptance/"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "expo": "~55.0.9",
    "expo-blur": "~55.0.18",
    "expo-camera": "~55.0.23",
    "expo-constants": "~55.0.9",
    "expo-dev-client": "~55.0.40",
    "expo-device": "~55.0.21",
    "expo-document-picker": "~55.0.17",
    "expo-font": "~55.0.4",
    "expo-glass-effect": "~55.0.11",
    "expo-haptics": "~55.0.18",
    "expo-image": "~55.0.11",
    "expo-linear-gradient": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-print": "~55.0.19",
    "expo-router": "~55.0.18",
    "expo-sharing": "^55.0.18",
    "expo-splash-screen": "~55.0.13",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.22",
    "expo-web-browser": "~55.0.20",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "docx": "^9.11.0",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.22",
    "selenium-webdriver": "^4.51.0",
    "test-renderer": "^1.3.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
